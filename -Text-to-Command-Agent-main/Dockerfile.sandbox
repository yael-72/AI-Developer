# ────────────────────────────────────────────────────────────
# סנדבוקס מבודד להרצת פקודות CLI
# בנייה:  docker build -f Dockerfile.sandbox -t proptproject-sandbox .
# ────────────────────────────────────────────────────────────
FROM alpine:3.20

# כלים מקבילים לפקודות Windows הנפוצות
RUN apk add --no-cache \
    iproute2 \
    iputils \
    net-tools \
    bind-tools \
    procps \
    coreutils \
    findutils \
    grep \
    diffutils \
    traceroute \
    bash

WORKDIR /sandbox

# הרצה כ-nobody (uid 65534) — ללא הרשאות root
USER 65534

CMD ["sh"]
